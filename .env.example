# Content source: "mock" reads /data/*.json (default). "http" fetches the backend.
CONTENT_SOURCE=mock

# Required only when CONTENT_SOURCE=http — the backend base URL.
# API_BASE_URL=https://api.mangos.example.com

# Public site URL (used for absolute metadata/canonicals).
# NEXT_PUBLIC_SITE_URL=https://mangos.example.com
